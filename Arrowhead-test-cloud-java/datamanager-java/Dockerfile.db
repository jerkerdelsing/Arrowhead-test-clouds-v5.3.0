# MySQL schema owned by the Java DataManager (ah_datamanager), initialised from the module's own scripts.
FROM mysql:8.4.11@sha256:24989179f58856db763f418010c1169fecc944e3ec1ea7e921572d83eb070f70

COPY --from=dmsrc src/main/resources/database /db-scripts
RUN sed -E 's#^(source[[:space:]]+)([^[:space:]]+)#\1/db-scripts/\2#' /db-scripts/create_empty_db.sql > /docker-entrypoint-initdb.d/init.sql \
 && chmod 644 /docker-entrypoint-initdb.d/init.sql
