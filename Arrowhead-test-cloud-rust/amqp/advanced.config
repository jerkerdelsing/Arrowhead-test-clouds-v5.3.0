[{rabbit, [{ssl_options, [{cacertfile, "/run/ca.pem"},
 {certfile, "/run/broker/cert.pem"}, {keyfile, "/run/broker/key.pem"},
 {verify, verify_peer}, {fail_if_no_peer_cert, true},
 {versions, ['tlsv1.3','tlsv1.2']}, {crl_check, peer},
 {crl_cache, {ssl_crl_hash_dir, {internal, [{dir, "/tmp/rabbitmq-crl"}]}}}]}]}].
