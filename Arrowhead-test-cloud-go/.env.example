# make init copies this to .env and adds random per-cloud secrets (scripts/rotate-secrets.sh generate).
# Go test cloud v5.3.0 (2026-11-11): own Compose project and host ports 74xx/7671/7883/7500, next to the 5.2 GoCloud
# (arrowhead-v52-test-cloud-go, 9xxx), the Java v5.3.0 cloud (84xx), the Rust cloud (10xxx) and the chiplet cloud (19xxx).
COMPOSE_PROJECT_NAME=arrowhead-v53-test-cloud-go
AH_VERSION=5.3.0
BIND_ADDRESS=127.0.0.1
CONSOLE_HOST=gocloud-v53.localhost

# Host API ports (container-to-container ports remain the Arrowhead defaults).
SERVICEREGISTRY_PORT=7443
DYNAMIC_ORCHESTRATION_PORT=7441
SIMPLE_ORCHESTRATION_PORT=7442
CONSUMER_AUTHORIZATION_PORT=7445
AUTHENTICATION_PORT=7444
BLACKLIST_PORT=7464
TRANSLATION_MANAGER_PORT=7465
TEST_TRANSLATION_PORT=7466
DEVICE_QOS_EVALUATOR_PORT=7472
ONBOARDING_PORT=7435
CLOUD_MONITOR_PORT=7490
DATAMANAGER_PORT=7461
RANDOM_DATA_PRODUCER_PORT=7500
GATEKEEPER_PORT=7449
GATETUNNEL_PORT=7453
SYSMONITOR_PORT=7475
MQTT_TLS_PORT=7883
AMQP_TLS_PORT=7671
EVENTHANDLER_PORT=7455
TIMEMANAGER_PORT=7463
CONFIGURATION_PORT=7459
CHOREOGRAPHER_PORT=7457
PLANTDESCRIPTIONENGINE_PORT=7432
AIGYM_PORT=7478
CERTIFICATE_AUTHORITY_PORT=7448
