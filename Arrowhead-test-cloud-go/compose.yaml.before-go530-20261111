name: ${COMPOSE_PROJECT_NAME:-arrowhead-v53-test-cloud-go}

x-db-common: &db-common
  platform: ${DOCKER_PLATFORM:-linux/amd64}
  restart: unless-stopped
  # TLS with the cloud-CA-signed certificate of security/x509/db/<host>; plain TCP connections are refused.
  command: ["--ssl-ca=/etc/mysql/tls/ca.crt", "--ssl-cert=/etc/mysql/tls/server.crt", "--ssl-key=/etc/mysql/tls/server.key", "--require-secure-transport=ON"]
  environment: &db-environment
    MYSQL_ROOT_PASSWORD: ${DB_ROOT_PSW:?Set DB_ROOT_PSW in .env}
    MYSQL_USER: ah-operator
    MYSQL_PASSWORD: ${DB_AH_OPERATOR_PSW:?Set DB_AH_OPERATOR_PSW in .env}
  healthcheck:
    test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
    interval: 4s
    timeout: 3s
    retries: 15
    start_period: 20s
  networks: [arrowhead]

x-go-system: &go-system
  # Native Go core/support systems (../ah5-core-go, ../ah5-support-go), 2026-10-17. JSON configuration in
  # runtime-go/<service>.json, credentials in security/bundles-go/<service> (scripts/make-go-runtime.sh),
  # private JSON state on the named volume go-<service>-state. Non-root (the image's 65532; J3): Docker Desktop shows
  # the owner-only (0600) bind-mounted bundle files as owned by the reading user. No capabilities, read-only root.
  image: arrowhead-go-native:5.2.2-20261017
  build:
    context: ./go-native-full
    dockerfile: Dockerfile.prebuilt
  platform: ${DOCKER_PLATFORM:-linux/amd64}
  restart: unless-stopped
  networks: [arrowhead]
  read_only: true
  cap_drop: [ALL]
  security_opt: [no-new-privileges:true]
  pids_limit: 128
  mem_limit: 192m

x-system-common: &system-common
  platform: ${DOCKER_PLATFORM:-linux/amd64}
  restart: unless-stopped
  networks: [arrowhead]

services:
  # Mandatory local-cloud core: ServiceRegistry
  # ServiceRegistry: Go implementation (ah5-core-go/ServiceRegistry) replacing the
  # Java-Spring reference image aitiaiiot/arrowhead-serviceregistry. Data is kept
  # in a JSON snapshot on a named volume, so no database container is needed.
  serviceregistry:
    <<: *system-common
    secrets:
      - { source: AH_PW_SR, target: identity-password }
      - { source: AH_AUTHENTICATION_SECRET_KEY, target: authentication-secret-key }
    build:
      context: ../ah5-core-go/ServiceRegistry
      dockerfile: Dockerfile.prebuilt
    image: arrowhead-serviceregistry-go:5.2.2-20261017
    # non-root (J3), the same user as the other Go systems; its data volume is owned by it
    user: "65532:65532"
    read_only: true
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    pids_limit: 128
    mem_limit: 128m
    environment:
      # Secrets as files (J7)
      AUTHENTICATOR_PASSWORD_FILE: /run/secrets/identity-password
      AUTHENTICATOR_SECRET_KEY_FILE: /run/secrets/authentication-secret-key
      # Revocation (J4): client certificates are checked against the cloud CA's CRL (fail closed)
      SERVER_SSL_CRL_FILE: /crl/ca.crl
      # Blacklist enforcement (J12); the core systems are not checked
      ENABLE_BLACKLIST_FILTER: "true"
      FORCE_BLACKLIST_FILTER: "true"
      BLACKLIST_CHECK_EXCLUDE_LIST: ServiceRegistry,Authentication,ConsumerAuthorization,DynamicServiceOrchestration,SimpleStoreServiceOrchestration,CertificateAuthority
      SYSMONITOR_LOCAL_CLOUD: GoCloud
      SYSMONITOR_ENABLED: "true"
      # MQTT API (2026-10-24, Java mqtt.api.enabled): arrowhead/serviceregistry/... on the local broker
      MQTT_API_ENABLED: "true"
      MQTT_BROKER_ADDRESS: mqtt-broker
      MQTT_BROKER_PORT: "8883"
      SYSMONITOR_SSL_CERT_FILE: /certs/serviceregistry.crt
      SYSMONITOR_SSL_KEY_FILE: /certs/serviceregistry.key
      SYSMONITOR_SSL_CA_FILE: /certs/ca.crt
      DOMAIN_NAME: serviceregistry
      SERVER_SSL_ENABLED: "true"
      SERVER_SSL_CERT_FILE: /certs/serviceregistry.crt
      SERVER_SSL_KEY_FILE: /certs/serviceregistry.key
      SERVER_SSL_TRUST_FILE: /certs/ca.crt
      SERVER_SSL_CLIENT_AUTH: need
      SERVER_COMMON_NAME: ServiceRegistry.GoCloud.Company.arrowhead.eu
      # Mutual TLS plus an identity token: every caller presents a local-cloud client certificate and an identity
      # token of the same system (token-to-certificate binding). Only the identity lookup is token-free, so that a
      # system can find Authentication before its first login.
      AUTHENTICATION_POLICY: outsourced
      MANAGEMENT_POLICY: whitelist
      # Onboarding: device-create, device-remove and system-remove of the onboarding procedure
      MANAGEMENT_WHITELIST: Authentication,LocalCloudManager,DynamicServiceOrchestration,DeviceQoSEvaluator,PlantDescriptionEngine,Onboarding
      DATA_FILE: /data/serviceregistry.json
    volumes:
      - ./runtime/ServiceRegistry-go/application.properties:/config/application.properties:ro
      - serviceregistry-data:/data
      - ./security/bundles/serviceregistry:/certs:ro
      - ./security/crl:/crl:ro
    ports:
      - "${BIND_ADDRESS:-127.0.0.1}:${SERVICEREGISTRY_PORT:-7443}:8443"

  # Mandatory local-cloud core: dynamic orchestration
  serviceorchestration-dynamic-db:
    profiles: ["java-legacy"] # former MySQL of the Java system; volume kept for rollback
    <<: *db-common
    image: aitiaiiot/arrowhead-serviceorchestration-dynamic-db:${AH_VERSION:-5.2.2}
    environment:
      <<: *db-environment
      # the system's own database user gets this cloud's password at initialization (H2)
      AH_DB_USER: serviceorchestration-dynamic
      AH_DB_USER_PASSWORD: "${AH_DB_PW_DYNAMICSERVICEORCHESTRATION:?run scripts/rotate-secrets.sh generate}"
    volumes:
      - serviceorchestration-dynamic-db:/var/lib/mysql
      - ./security/x509/db/serviceorchestration-dynamic-db:/etc/mysql/tls:ro
      - ./db/zz-arrowhead-system-user-password.sh:/docker-entrypoint-initdb.d/zz-arrowhead-system-user-password.sh:ro

  serviceorchestration-dynamic:
    <<: *go-system
    entrypoint: ["/usr/local/bin/serviceorchestration-dynamic", "-config", "/config/config.json"]
    # was memory-cgroup OOM-killed (exit 137) at the shared 192m with ~195 MB RSS (2026-10-23):
    # more headroom plus a soft Go heap limit so the GC works before the cgroup limit is reached
    mem_limit: 256m
    environment:
      GOMEMLIMIT: 150MiB
    depends_on:
      serviceregistry:
        condition: service_started
      authentication:
        condition: service_started
    volumes:
      - ./runtime-go/serviceorchestration-dynamic.json:/config/config.json:ro
      - ./security/bundles-go/serviceorchestration-dynamic:/certs:ro
      - go-serviceorchestration-dynamic-state:/state
      # revocation (J4): the cloud CA's CRL, read on every handshake (crlFile)
      - ./security/crl:/crl:ro
    ports:
      - "${BIND_ADDRESS:-127.0.0.1}:${DYNAMIC_ORCHESTRATION_PORT:-8441}:8441"
    healthcheck:
      test: ["CMD", "/usr/local/bin/ah-probe", "127.0.0.1:8441"]
      interval: 30s
      timeout: 4s
      retries: 3
      start_period: 60s
      start_interval: 2s

  # Optional alternative orchestrator introduced in 5.2.
  serviceorchestration-simple-db:
    profiles: ["java-legacy"] # former MySQL of the Java system; volume kept for rollback
    <<: *db-common
    image: aitiaiiot/arrowhead-serviceorchestration-simple-db:${AH_VERSION:-5.2.2}
    environment:
      <<: *db-environment
      # the system's own database user gets this cloud's password at initialization (H2)
      AH_DB_USER: serviceorchestration-simple
      AH_DB_USER_PASSWORD: "${AH_DB_PW_SIMPLESTORESERVICEORCHESTRATION:?run scripts/rotate-secrets.sh generate}"
    volumes:
      - serviceorchestration-simple-db:/var/lib/mysql
      - ./security/x509/db/serviceorchestration-simple-db:/etc/mysql/tls:ro
      - ./db/zz-arrowhead-system-user-password.sh:/docker-entrypoint-initdb.d/zz-arrowhead-system-user-password.sh:ro

  serviceorchestration-simple:
    <<: *go-system
    entrypoint: ["/usr/local/bin/serviceorchestration-simple", "-config", "/config/config.json"]
    depends_on:
      serviceregistry:
        condition: service_started
      authentication:
        condition: service_started
    volumes:
      - ./runtime-go/serviceorchestration-simple.json:/config/config.json:ro
      - ./security/bundles-go/serviceorchestration-simple:/certs:ro
      - go-serviceorchestration-simple-state:/state
      # revocation (J4): the cloud CA's CRL, read on every handshake (crlFile)
      - ./security/crl:/crl:ro
    ports:
      - "${BIND_ADDRESS:-127.0.0.1}:${SIMPLE_ORCHESTRATION_PORT:-7442}:8442"
    healthcheck:
      test: ["CMD", "/usr/local/bin/ah-probe", "127.0.0.1:8442"]
      interval: 30s
      timeout: 4s
      retries: 3
      start_period: 60s
      start_interval: 2s

  # Mandatory local-cloud core: ConsumerAuthorization
  consumerauthorization-db:
    profiles: ["java-legacy"] # former MySQL of the Java system; volume kept for rollback
    <<: *db-common
    image: aitiaiiot/arrowhead-consumerauthorization-db:${AH_VERSION:-5.2.2}
    environment:
      <<: *db-environment
      # the system's own database user gets this cloud's password at initialization (H2)
      AH_DB_USER: consumerauthorization
      AH_DB_USER_PASSWORD: "${AH_DB_PW_CONSUMERAUTHORIZATION:?run scripts/rotate-secrets.sh generate}"
    volumes:
      - consumerauthorization-db:/var/lib/mysql
      - ./security/x509/db/consumerauthorization-db:/etc/mysql/tls:ro
      - ./db/zz-arrowhead-system-user-password.sh:/docker-entrypoint-initdb.d/zz-arrowhead-system-user-password.sh:ro

  consumerauthorization:
    <<: *go-system
    entrypoint: ["/usr/local/bin/consumer-authorization", "-config", "/config/config.json"]
    depends_on:
      serviceregistry:
        condition: service_started
      authentication:
        condition: service_started
    volumes:
      - ./runtime-go/consumerauthorization.json:/config/config.json:ro
      - ./security/bundles-go/consumerauthorization:/certs:ro
      - go-consumerauthorization-state:/state
      # revocation (J4): the cloud CA's CRL, read on every handshake (crlFile)
      - ./security/crl:/crl:ro
    ports:
      - "${BIND_ADDRESS:-127.0.0.1}:${CONSUMER_AUTHORIZATION_PORT:-8445}:8445"
    healthcheck:
      test: ["CMD", "/usr/local/bin/ah-probe", "127.0.0.1:8445"]
      interval: 30s
      timeout: 4s
      retries: 3
      start_period: 60s
      start_interval: 2s

  # Mandatory Authentication core for outsourced identity tokens.
  authentication-db:
    profiles: ["java-legacy"] # former MySQL of the Java system; volume kept for rollback
    <<: *db-common
    image: aitiaiiot/arrowhead-authentication-db:${AH_VERSION:-5.2.2}
    environment:
      <<: *db-environment
      # the system's own database user gets this cloud's password at initialization (H2)
      AH_DB_USER: authentication
      AH_DB_USER_PASSWORD: "${AH_DB_PW_AUTHENTICATION:?run scripts/rotate-secrets.sh generate}"
    volumes:
      - authentication-db:/var/lib/mysql
      - ./security/x509/db/authentication-db:/etc/mysql/tls:ro
      - ./db/zz-arrowhead-system-user-password.sh:/docker-entrypoint-initdb.d/zz-arrowhead-system-user-password.sh:ro


  authentication:
    <<: *go-system
    entrypoint: ["/usr/local/bin/authentication", "-config", "/config/config.json"]
    depends_on:
      serviceregistry:
        condition: service_started
    volumes:
      - ./runtime-go/authentication.json:/config/config.json:ro
      - ./security/bundles-go/authentication:/certs:ro
      - go-authentication-state:/state
      # revocation (J4): the cloud CA's CRL, read on every handshake (crlFile)
      - ./security/crl:/crl:ro
    ports:
      - "${BIND_ADDRESS:-127.0.0.1}:${AUTHENTICATION_PORT:-8444}:8444"
    healthcheck:
      test: ["CMD", "/usr/local/bin/ah-probe", "127.0.0.1:8444"]
      interval: 30s
      timeout: 4s
      retries: 3
      start_period: 60s
      start_interval: 2s

  # Released v5 support: Blacklist
  blacklist-db:
    profiles: ["java-legacy"] # former MySQL of the Java system; volume kept for rollback
    <<: *db-common
    image: aitiaiiot/arrowhead-blacklist-db:${AH_VERSION:-5.2.2}
    environment:
      <<: *db-environment
      # the system's own database user gets this cloud's password at initialization (H2)
      AH_DB_USER: blacklist
      AH_DB_USER_PASSWORD: "${AH_DB_PW_BLACKLIST:?run scripts/rotate-secrets.sh generate}"
    volumes:
      - blacklist-db:/var/lib/mysql
      - ./security/x509/db/blacklist-db:/etc/mysql/tls:ro
      - ./db/zz-arrowhead-system-user-password.sh:/docker-entrypoint-initdb.d/zz-arrowhead-system-user-password.sh:ro

  blacklist:
    <<: *go-system
    entrypoint: ["/usr/local/bin/Blacklist", "-config", "/config/config.json"]
    depends_on:
      serviceregistry:
        condition: service_started
      authentication:
        condition: service_started
    volumes:
      - ./runtime-go/blacklist.json:/config/config.json:ro
      - ./security/bundles-go/blacklist:/certs:ro
      - go-blacklist-state:/state
      # revocation (J4): the cloud CA's CRL, read on every handshake (crlFile)
      - ./security/crl:/crl:ro
    ports:
      - "${BIND_ADDRESS:-127.0.0.1}:${BLACKLIST_PORT:-8464}:8464"
    healthcheck:
      test: ["CMD", "/usr/local/bin/ah-probe", "127.0.0.1:8464"]
      interval: 30s
      timeout: 4s
      retries: 3
      start_period: 60s
      start_interval: 2s

  # Java Blacklist with its MQTT API (2026-10-24; make swap-java-blacklist / make restore-go-blacklist): the released
  # Java system (image of TestCloud's java-patch build, not rebuilt here) in place of the Go Blacklist, which is only
  # stopped (its state volume go-blacklist-state stays). The network alias keeps https://blacklist:8464 for all
  # callers. Never run both: they share the alias and the host port. Hardened as TestCloud's Java systems: its own
  # MySQL 8.4 database on an internal network (J1/J8), secrets only as files (J7), keystores with its own password in
  # its credential bundle (security/bundles-java, scripts/make-java-blacklist-bundle.sh), read-only and non-root (J3).
  blacklist-java-db:
    profiles: ["java-blacklist"]
    <<: *db-common
    image: arrowhead-blacklist-db:${AH_VERSION:-5.2.2}-mysql8.4
    pull_policy: never
    command: ["--innodb-use-native-aio=0", "--ssl-ca=/etc/mysql/tls/ca.crt", "--ssl-cert=/etc/mysql/tls/server.crt", "--ssl-key=/etc/mysql/tls/server.key", "--require-secure-transport=ON"]
    # the official entrypoint, wrapped so that mysqld starts without the passwords in its environment (J7)
    entrypoint: ["/usr/local/bin/ah-db-entrypoint.sh"]
    user: "999:999"
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    mem_limit: 768m
    pids_limit: 512
    tmpfs:
      - /var/run/mysqld:rw,nosuid,nodev,uid=999,gid=999,mode=0750,size=1m
      - /tmp:rw,nosuid,nodev,mode=1777,size=64m
    secrets:
      - { source: AH_DB_ROOT_BLACKLIST, target: db-root-password }
      - { source: AH_DB_PW_BLACKLIST, target: db-user-password }
    environment:
      MYSQL_ROOT_PASSWORD_FILE: /run/secrets/db-root-password
      AH_DB_USER: blacklist
      AH_DB_USER_PASSWORD_FILE: /run/secrets/db-user-password
    volumes:
      - blacklist-java-db:/var/lib/mysql
      - ./security/bundles-java/blacklist-db:/etc/mysql/tls:ro
      - ./db/mysql-entrypoint.sh:/usr/local/bin/ah-db-entrypoint.sh:ro
      - ./db/zz-arrowhead-system-user-password.sh:/docker-entrypoint-initdb.d/zz-arrowhead-system-user-password.sh:ro
      - ./db/00-temporary-ah-operator.sql:/docker-entrypoint-initdb.d/00-temporary-ah-operator.sql:ro
      - ./db/zzz-drop-temporary-ah-operator.sql:/docker-entrypoint-initdb.d/zzz-drop-temporary-ah-operator.sql:ro
    # reachable only from blacklist-java (J1); the JDBC URL names blacklist-db, the host of its TLS certificate
    networks:
      db-blacklist-java:
        aliases: [blacklist-db]

  blacklist-java:
    profiles: ["java-blacklist"]
    <<: *system-common
    image: arrowhead-blacklist:5.2.2-sysmonitor
    pull_policy: never
    # Hardening (J3) as in TestCloud: read-only root filesystem, no capabilities, no privilege gain
    user: "10001:10001"
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    mem_limit: 1g
    pids_limit: 256
    tmpfs:
      - /tmp:rw,nosuid,nodev,mode=1777,size=64m
      - /app/logs:rw,nosuid,nodev,noexec,mode=1777,size=32m
    networks:
      arrowhead:
        aliases: [blacklist]
      db-blacklist-java: {}
    depends_on:
      blacklist-java-db:
        condition: service_healthy
      serviceregistry:
        condition: service_started
    secrets:
      - { source: AH_DB_PW_BLACKLIST, target: ah.db-password }
      - { source: AH_PW_BL, target: ah.identity-password }
      - { source: AH_STORE_PW_BL, target: ah.store-password }
    environment:
      ARROWHEAD_CLOUD_NAME: GoCloud
      # Secrets are files under /run/secrets (J7), read through Spring's config tree; the environment holds only
      # ${ah.*} references to them
      SPRING_CONFIG_IMPORT: "configtree:/run/secrets/"
      # No generated in-memory user (J14)
      SPRING_AUTOCONFIGURE_EXCLUDE: org.springframework.boot.autoconfigure.security.servlet.UserDetailsServiceAutoConfiguration
      LOG4J_CONFIGURATION_FILE: /app/config/log4j2.xml
      # Revocation (J4)
      ARROWHEAD_SSL_CRL_FILE: /crl/ca.crl
      SYSMONITOR_ENABLED: "true"
      SYSMONITOR_SSL_KEY_STORE: file:/app/config/certificate/Blacklist.p12
      SYSMONITOR_SSL_KEY_STORE_PASSWORD: "$${ah.store-password}"
      SYSMONITOR_SSL_TRUST_STORE: file:/app/config/certificate/truststore.p12
      SYSMONITOR_SSL_TRUST_STORE_PASSWORD: "$${ah.store-password}"
      SPRING_DATASOURCE_URL: jdbc:mariadb://blacklist-db:3306/ah_blacklist?sslMode=verify-full&serverSslCert=/etc/arrowhead/db-tls/ca.crt
      SPRING_DATASOURCE_PASSWORD: "$${ah.db-password}"
      DOMAIN_NAME: blacklist
      SERVICE_REGISTRY_ADDRESS: serviceregistry
      SERVICE_REGISTRY_PORT: 8443
      AUTHENTICATION_POLICY: outsourced
      AUTHENTICATOR_CREDENTIALS: "{'password':'$${ah.identity-password}'}"
      SERVER_SSL_ENABLED: "true"
      SERVER_SSL_KEY_STORE: file:/app/config/certificate/Blacklist.p12
      SERVER_SSL_KEY_STORE_PASSWORD: "$${ah.store-password}"
      SERVER_SSL_KEY_PASSWORD: "$${ah.store-password}"
      SERVER_SSL_TRUST_STORE: file:/app/config/certificate/truststore.p12
      SERVER_SSL_TRUST_STORE_PASSWORD: "$${ah.store-password}"
      SERVER_SSL_CLIENT_AUTH: need
      SERVER_SSL_ENABLED_PROTOCOLS: TLSv1.3,TLSv1.2
      SERVICE_INTERFACE_POLICY: CERT_AUTH
      # MQTT API: arrowhead/blacklist/... on the local broker (TLS with the system keystore; user = certificate subject)
      MQTT_API_ENABLED: "true"
      MQTT_BROKER_ADDRESS: mqtt-broker
      MQTT_BROKER_PORT: "8883"
      JAVA_TOOL_OPTIONS: "-Xms64m -Xmx256m"
    volumes:
      # credential bundle (J15): keystores with the system's own password, and the CA for the database TLS
      - ./security/bundles-java/blacklist/ca.crt:/etc/arrowhead/db-tls/ca.crt:ro
      - ./security/bundles-java/blacklist/keystores:/app/config/certificate:ro
      - ./security/crl:/crl:ro
    ports:
      - "${BIND_ADDRESS:-127.0.0.1}:${BLACKLIST_PORT:-8464}:8464"
    healthcheck:
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8464"]
      interval: 10s
      timeout: 4s
      retries: 12
      start_period: 60s

  # Released v5 support: TranslationManager
  translation-manager-db:
    profiles: ["java-legacy"] # former MySQL of the Java system; volume kept for rollback
    <<: *db-common
    image: aitiaiiot/arrowhead-translation-manager-db:${AH_VERSION:-5.2.2}
    environment:
      <<: *db-environment
      # the system's own database user gets this cloud's password at initialization (H2)
      AH_DB_USER: translationmanager
      AH_DB_USER_PASSWORD: "${AH_DB_PW_TRANSLATIONMANAGER:?run scripts/rotate-secrets.sh generate}"
    volumes:
      - translation-manager-db:/var/lib/mysql
      - ./security/x509/db/translation-manager-db:/etc/mysql/tls:ro
      - ./db/zz-arrowhead-system-user-password.sh:/docker-entrypoint-initdb.d/zz-arrowhead-system-user-password.sh:ro

  translation-manager:
    <<: *go-system
    entrypoint: ["/usr/local/bin/TranslationManager", "-config", "/config/config.json"]
    depends_on:
      serviceregistry:
        condition: service_started
      authentication:
        condition: service_started
    volumes:
      - ./runtime-go/translation-manager.json:/config/config.json:ro
      - ./security/bundles-go/translation-manager:/certs:ro
      - go-translation-manager-state:/state
      # revocation (J4): the cloud CA's CRL, read on every handshake (crlFile)
      - ./security/crl:/crl:ro
    ports:
      - "${BIND_ADDRESS:-127.0.0.1}:${TRANSLATION_MANAGER_PORT:-7465}:8465"
    healthcheck:
      test: ["CMD", "/usr/local/bin/ah-probe", "127.0.0.1:8465"]
      interval: 30s
      timeout: 4s
      retries: 3
      start_period: 60s
      start_interval: 2s

  # Test application system of the TranslationManager (2026-10-24): generic_https interface translator and
  # simpleJson <-> senml data model translator (ah5-support-go, role TestTranslation); smoke-translation.sh
  test-translation:
    <<: *go-system
    entrypoint: ["/usr/local/bin/TestTranslation", "-config", "/config/config.json"]
    depends_on:
      serviceregistry:
        condition: service_started
      authentication:
        condition: service_started
    volumes:
      - ./runtime-go/test-translation.json:/config/config.json:ro
      - ./security/bundles-go/test-translation:/certs:ro
      - go-test-translation-state:/state
      # revocation (J4): the cloud CA's CRL, read on every handshake (crlFile)
      - ./security/crl:/crl:ro
    ports:
      - "${BIND_ADDRESS:-127.0.0.1}:${TEST_TRANSLATION_PORT:-7466}:8466"
    healthcheck:
      test: ["CMD", "/usr/local/bin/ah-probe", "127.0.0.1:8466"]
      interval: 30s
      timeout: 4s
      retries: 3
      start_period: 60s
      start_interval: 2s

  # Released v5.2 support: DeviceQoSEvaluator
  device-qos-evaluator-db:
    profiles: ["java-legacy"] # former MySQL of the Java system; volume kept for rollback
    <<: *db-common
    image: aitiaiiot/arrowhead-device-qos-evaluator-db:${AH_VERSION:-5.2.2}
    environment:
      <<: *db-environment
      # the system's own database user gets this cloud's password at initialization (H2)
      AH_DB_USER: deviceqosevaluator
      AH_DB_USER_PASSWORD: "${AH_DB_PW_DEVICEQOSEVALUATOR:?run scripts/rotate-secrets.sh generate}"
    volumes:
      - device-qos-evaluator-db:/var/lib/mysql
      - ./security/x509/db/device-qos-evaluator-db:/etc/mysql/tls:ro
      - ./db/zz-arrowhead-system-user-password.sh:/docker-entrypoint-initdb.d/zz-arrowhead-system-user-password.sh:ro

  device-qos-evaluator:
    <<: *go-system
