  # X.509-only MQTT 5 broker for Monitoring and SysMonitor data-plane traffic.
  mqtt-broker:
    # Hardening (J3): read-only root filesystem, no capabilities, no privilege gain, bounded memory/processes
    user: "1883:1883"
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    mem_limit: 192m
    pids_limit: 64
    tmpfs:
      - /tmp:rw,nosuid,nodev,mode=1777,size=64m
    image: eclipse-mosquitto:2.0.22@sha256:199ea8ef2e35ec2b1b37e59cfd1dbae538ed4dfa4a2251a121a52215a6248a21
    # crl-watch.sh keeps crlfile current from the CertificateAuthority's CRL and reloads the broker (H3)
    entrypoint: ["/mosquitto/config/crl-watch.sh"]
    command: ["/usr/sbin/mosquitto", "-c", "/mosquitto/config/mosquitto.conf"]
    restart: unless-stopped
    volumes:
      - ./mqtt/mosquitto.conf:/mosquitto/config/mosquitto.conf:ro
      - ./mqtt/acl:/mosquitto/config/acl:ro
      - ./mqtt/crl-watch.sh:/mosquitto/config/crl-watch.sh:ro
      - ./security/bundles/mqtt-broker:/certs:ro
      - ./security/crl:/crl:ro
      - mqtt-data:/mosquitto/data
    networks: [arrowhead]
    ports:
      - "${BIND_ADDRESS:-127.0.0.1}:${MQTT_TLS_PORT:-8883}:8883"
    healthcheck:
      test: ["CMD", "nc", "-z", "-w", "2", "127.0.0.1", "8883"]
      interval: 10s
      timeout: 4s
      retries: 8
      start_period: 5s

  # SysMonitor implements the generated SysDD and IDDs: MQTT intake/output, the system-owned
  # observation history of all monitored microsystems (sysMonitorHistory, SQLite in sysmonitor-data),
  # durable outbox for sysMonitorData, subscription policy and mTLS management.

  # X.509-only AMQP 0-9-1 broker (RabbitMQ) for the sysMonitor services of all systems. Users are the client
  # certificate CNs (SASL EXTERNAL); amqp/acl -> amqp/definitions.json (make amqp-acl) sets what each may publish.
  amqp-broker:
    # Hardening (J3): read-only root filesystem, no capabilities, no privilege gain, bounded memory/processes
    user: "100:101"
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    mem_limit: 512m
    pids_limit: 1024
    tmpfs:
      - /tmp:rw,nosuid,nodev,mode=1777,size=64m
    image: rabbitmq:4.3.6-alpine@sha256:6931816af1a943f471c038b278835d36692d55dec769232739296bb91b7de0f5
    hostname: amqp-broker
    restart: unless-stopped
    entrypoint: ["/etc/rabbitmq/entrypoint.sh"]
    environment:
      # Single node (J10): epmd and the Erlang distribution port listen on loopback only, so no other container can
      # reach them (the broker's own CLI tools, e.g. the healthcheck, connect locally)
      ERL_EPMD_ADDRESS: 127.0.0.1
      # the node name must resolve to loopback for that (the host name amqp-broker resolves to the network address)
      RABBITMQ_NODENAME: rabbit@localhost
      RABBITMQ_SERVER_ADDITIONAL_ERL_ARGS: "-kernel inet_dist_use_interface {127,0,0,1}"
    volumes:
      - ./amqp/rabbitmq.conf:/etc/rabbitmq/rabbitmq.conf:ro
      - ./amqp/enabled_plugins:/etc/rabbitmq/enabled_plugins:ro
      - ./amqp/definitions.json:/etc/rabbitmq/definitions.json:ro
      - ./amqp/entrypoint.sh:/etc/rabbitmq/entrypoint.sh:ro
      - ./amqp/advanced.config:/etc/rabbitmq/advanced.config:ro
      - ./security/bundles/amqp-broker:/certs:ro
      - ./security/crl:/crl:ro
      - amqp-data:/var/lib/rabbitmq
    networks: [arrowhead]
    ports:
      - "${BIND_ADDRESS:-127.0.0.1}:${AMQP_TLS_PORT:-5671}:5671"
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "-q", "check_port_listener", "5671"]
      interval: 10s
      timeout: 8s
      retries: 12
      start_period: 20s

  sysmonitor:
    <<: *go-system
    entrypoint: ["/usr/local/bin/SysMonitor", "-config", "/config/config.json"]
    environment:
      # soft Go heap limit below mem_limit: the observation history is ~90 MiB live, so the default GOGC=100
      # target (2x live) would exceed the 192 MB container limit
      GOMEMLIMIT: 150MiB
    depends_on:
      serviceregistry:
        condition: service_started
      authentication:
        condition: service_started
    volumes:
      - ./runtime-go/sysmonitor.json:/config/config.json:ro
      - ./security/bundles-go/sysmonitor:/certs:ro
      - go-sysmonitor-state:/state
      # revocation (J4): the cloud CA's CRL, read on every handshake (crlFile)
      - ./security/crl:/crl:ro
    ports:
      - "${BIND_ADDRESS:-127.0.0.1}:${SYSMONITOR_PORT:-8475}:8475"
    healthcheck:
      test: ["CMD", "/usr/local/bin/ah-probe", "127.0.0.1:8475"]
      interval: 30s
      timeout: 4s
      retries: 3
      start_period: 60s
      start_interval: 2s

  # Arrowhead 5.2.2 Gatekeeper compatibility microsystem. It preserves the
  # v4.6 GSD/ICN resource paths while using v5 service-operation registration,
  # independent storage, outsourced Authentication and mandatory mTLS.
  gatekeeper:
    <<: *go-system
    image: arrowhead-go-federation:5.2.2-rust-peer-20261019
    entrypoint: ["/usr/local/bin/Gatekeeper", "-config", "/config/config.json"]
    depends_on:
      serviceregistry:
        condition: service_started
      authentication:
        condition: service_started
    environment:
      FEDERATION_PEER_ORGANIZATIONS: RustDev=Lab
      # end-to-end protected inter-cloud sessions (J5); both clouds must use the same profile, there is no fallback
      FEDERATION_PROFILE: ah-gt-1
      RELAY_HOST: arrowhead-relay
      RELAY_PORT: 8883
      CONSUMER_AUTHORIZATION_URL: https://consumerauthorization:8445
      GATETUNNEL_URL: https://gatetunnel:8453
    volumes:
      - ./runtime-go/gatekeeper.json:/config/config.json:ro
      - ./security/bundles-go/gatekeeper:/certs:ro
      - go-gatekeeper-state:/state
      # revocation (J4): the cloud CA's CRL, read on every handshake (crlFile)
      - ./security/crl:/crl:ro
    ports:
      - "${BIND_ADDRESS:-127.0.0.1}:${GATEKEEPER_PORT:-8449}:8449"
    healthcheck:
      test: ["CMD", "/usr/local/bin/ah-probe", "127.0.0.1:8449"]
      interval: 30s
      timeout: 4s
      retries: 3
      start_period: 60s
      start_interval: 2s

  # The v5.2.2 successor to the v4.6 Gateway is deliberately named
  # GateTunnel to distinguish its secured tunnel/session contract.
  gatetunnel:
    <<: *go-system
    image: arrowhead-go-federation:5.2.2-rust-peer-20261019
    entrypoint: ["/usr/local/bin/GateTunnel", "-config", "/config/config.json"]
    depends_on:
      serviceregistry:
        condition: service_started
      authentication:
        condition: service_started
    environment:
      FEDERATION_PEER_ORGANIZATIONS: RustDev=Lab
      # end-to-end protected inter-cloud sessions (J5); both clouds must use the same profile, there is no fallback
      FEDERATION_PROFILE: ah-gt-1
      RELAY_HOST: arrowhead-relay
      RELAY_PORT: 8883
      ADVERTISED_ADDRESS: gatetunnel
      MIN_TUNNEL_PORT: 8000
      MAX_TUNNEL_PORT: 8099
      NEIGHBOR_CLOUDS: TestCloud,RustDev
    volumes:
      - ./runtime-go/gatetunnel.json:/config/config.json:ro
      - ./security/bundles-go/gatetunnel:/certs:ro
      - go-gatetunnel-state:/state
      # revocation (J4): the cloud CA's CRL, read on every handshake (crlFile)
      - ./security/crl:/crl:ro
    ports:
      - "${BIND_ADDRESS:-127.0.0.1}:${GATETUNNEL_PORT:-8453}:8453"
    healthcheck:
      test: ["CMD", "/usr/local/bin/ah-probe", "127.0.0.1:8453"]
      interval: 30s
      timeout: 4s
      retries: 3
      start_period: 60s
      start_interval: 2s


  # Arrowhead 5.2.2 secure AI experimentation support system.
  aigym:
    <<: *go-system
    entrypoint: ["/usr/local/bin/AIGym", "-config", "/config/config.json"]
    depends_on:
      serviceregistry:
        condition: service_started
      authentication:
        condition: service_started
    volumes:
      - ./runtime-go/aigym.json:/config/config.json:ro
      - ./security/bundles-go/aigym:/certs:ro
      - go-aigym-state:/state
      # revocation (J4): the cloud CA's CRL, read on every handshake (crlFile)
      - ./security/crl:/crl:ro
    ports:
      - "${BIND_ADDRESS:-127.0.0.1}:${AIGYM_PORT:-8478}:8478"
    healthcheck:
      test: ["CMD", "/usr/local/bin/ah-probe", "127.0.0.1:8478"]
      interval: 30s
      timeout: 4s
      retries: 3
      start_period: 60s
      start_interval: 2s

  # Certificate Authority support system with v5.2.2 discovery and MQTT sysMonitor.
  certificate-authority:
    <<: *go-system
    entrypoint: ["/usr/local/bin/CertificateAuthority", "-config", "/config/config.json"]
    depends_on:
      serviceregistry:
        condition: service_started
      authentication:
        condition: service_started
    volumes:
      - ./runtime-go/certificate-authority.json:/config/config.json:ro
      - ./security/bundles-go/certificate-authority:/certs:ro
      - go-certificate-authority-state:/state
      # published CRL (crlExportFile), read by the brokers and the relay
      - ./security/crl:/crl
    ports:
      - "${BIND_ADDRESS:-127.0.0.1}:${CERTIFICATE_AUTHORITY_PORT:-8448}:8448"
    healthcheck:
      test: ["CMD", "/usr/local/bin/ah-probe", "127.0.0.1:8448"]
      interval: 30s
      timeout: 4s
      retries: 3
      start_period: 60s
      start_interval: 2s

  # LocalCloudManager microsystem: Arrowhead adapter and Docker collector
  cloud-monitor-api:
    # Hardening (J3): read-only root filesystem, no capabilities, no privilege gain, bounded memory/processes
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    mem_limit: 256m
    pids_limit: 128
    tmpfs:
      - /tmp:rw,nosuid,nodev,mode=1777,size=64m
    secrets:
      - { source: CONSOLE_PASSWORD_HASH, target: console-password-hash }
      - { source: CONSOLE_PROXY_SECRET, target: console-proxy-secret }
      - { source: AH_PW_LCM, target: identity-password }
    build:
      context: ../ah5-support-java-spring/LocalCloudManager/api
    image: arrowhead-local-cloud-monitor-api:1.0.0
    restart: unless-stopped
    depends_on:
      serviceregistry:
        condition: service_started
      authentication:
        condition: service_started
      docker-proxy:
        condition: service_healthy
    environment:
      ORCHESTRATION_PRIORITY_MODE: replace
      # Secrets as files (J7)
      AUTHENTICATION_PASSWORD_FILE: /run/secrets/identity-password
      CONSOLE_PASSWORD_HASH_FILE: /run/secrets/console-password-hash
      # The console's own host name (J6): its session cookie is not shared with other consoles on 127.0.0.1
      CONSOLE_ALLOWED_HOSTS: ${CONSOLE_HOST:-gocloud-v53.localhost}
      # Only requests forwarded by cloud-monitor-ui (which adds this secret) are served (J6)
      CONSOLE_PROXY_SECRET_FILE: /run/secrets/console-proxy-secret
      # Revocation (J4): providers' certificates are checked against the cloud CA's CRL
      TLS_CRL_FILE: /crl/ca.crl
      SYSMONITOR_LOCAL_CLOUD: GoCloud
      PORT: 8491
      COMPOSE_PROJECT_NAME: ${COMPOSE_PROJECT_NAME:-arrowhead-v53-test-cloud-go}
      ARROWHEAD_VERSION: ${AH_VERSION:-5.2.2}
      SERVICE_REGISTRY_URL: https://serviceregistry:8443
      DATAMANAGER_URL: https://datamanager:8461
      SYSMONITOR_URL: https://sysmonitor:8475
      SIMPLE_ORCHESTRATION_URL: https://serviceorchestration-simple:8442
      AUTHENTICATION_URL: https://authentication:8444
      ARROWHEAD_SYSTEM_NAME: LocalCloudManager
      ARROWHEAD_ADMIN_SYSTEM: Sysop
      # Operator login (salted scrypt hash of CONSOLE_PASSWORD) and the local names the console answers to (H1)
      DOCKER_API_URL: http://docker-proxy:2375
      TLS_CA_CERT: /certs/ca.crt
      TLS_CLIENT_CERT: /certs/local-cloud-manager.crt
      TLS_CLIENT_KEY: /certs/local-cloud-manager.key
      MANAGED_SERVICES: serviceregistry,serviceorchestration-dynamic,serviceorchestration-simple,consumerauthorization,authentication,blacklist,translation-manager,test-translation,device-qos-evaluator,onboarding,datamanager,timemanager,eventhandler,plantdescriptionengine,configuration,choreographer,random-data-producer,sysmonitor,aigym,certificate-authority,mqtt-broker,amqp-broker,gatekeeper,gatetunnel
    volumes:
      - ./security/bundles/cloud-monitor-api:/certs:ro
      - ./security/crl:/crl:ro
    networks: [arrowhead, console-docker, console]
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:8491/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
      interval: 10s
      timeout: 4s
      retries: 6
      start_period: 10s

  # Whitelisting Docker API proxy for the console (H1): the only container with the Docker socket. It forwards
  # list, logs and start/stop/restart for this project's containers (lifecycle only for MANAGED_SERVICES), nothing else,
  # on the internal network console-docker that only cloud-monitor-api joins.
  docker-proxy:
    # Hardening (J3): read-only root filesystem, no capabilities, no privilege gain, bounded memory/processes
    # SOS-8 (2026-11-10): the image's node user, in group 0 for the socket (srw-rw---- root:root); not root
    user: "1000:0"
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    mem_limit: 64m
    pids_limit: 64
    build:
      context: ../ah5-support-java-spring/LocalCloudManager/docker-proxy
    image: arrowhead-console-docker-proxy:1.0.0
    restart: unless-stopped
    environment:
      COMPOSE_PROJECT_NAME: ${COMPOSE_PROJECT_NAME:-arrowhead-v53-test-cloud-go}
      MANAGED_SERVICES: serviceregistry,serviceorchestration-dynamic,serviceorchestration-simple,consumerauthorization,authentication,blacklist,translation-manager,device-qos-evaluator,onboarding,datamanager,timemanager,eventhandler,plantdescriptionengine,configuration,choreographer,random-data-producer,sysmonitor,aigym,certificate-authority,mqtt-broker,amqp-broker,gatekeeper,gatetunnel
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks: [console-docker]
    healthcheck:
      test: ["CMD", "nc", "-z", "127.0.0.1", "2375"]
      interval: 10s
      timeout: 4s
      retries: 6
      start_period: 5s

  cloud-monitor-ui:
    # Hardening (J3): read-only root filesystem, no capabilities, no privilege gain, bounded memory/processes
    user: "101:101"
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    mem_limit: 64m
    pids_limit: 64
    tmpfs:
      - /var/cache/nginx:rw,nosuid,nodev,mode=1777,size=16m
      - /run:rw,nosuid,nodev,mode=1777,size=1m
      - /tmp:rw,nosuid,nodev,mode=1777,size=64m
    build:
      context: ../ah5-support-java-spring/LocalCloudManager/ui
    image: arrowhead-local-cloud-monitor-ui:1.0.0
    restart: unless-stopped
    depends_on:
      cloud-monitor-api:
        condition: service_healthy
    secrets:
      - { source: CONSOLE_PROXY_SECRET, target: console-proxy-secret }
    environment:
      # Canonical console address (J6): any other host name, e.g. 127.0.0.1, is redirected here
      CONSOLE_CANONICAL_HOST: ${CONSOLE_HOST:-gocloud-v53.localhost}
      CONSOLE_CANONICAL_ORIGIN: http://${CONSOLE_HOST:-gocloud-v53.localhost}:${CLOUD_MONITOR_PORT:-7490}
      CONSOLE_PROXY_SECRET_FILE: /run/secrets/console-proxy-secret
    # Only the console API is reachable from here, and only the host reaches the UI (J6)
    networks: [console]
    ports:
      - "${BIND_ADDRESS:-127.0.0.1}:${CLOUD_MONITOR_PORT:-7490}:8490"
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://127.0.0.1:8490/health"]
      interval: 10s
      timeout: 4s
      retries: 6
      start_period: 10s

networks:
  # blacklist-java <-> its database only (J1)
  db-blacklist-java:
    internal: true
  # Console API <-> Docker proxy only; internal, so it has no route outside
  console-docker:
    internal: true
  # Console UI <-> console API only (J6); not internal, so the UI can publish its port on the host
  console: {}
  arrowhead:
    name: ${COMPOSE_PROJECT_NAME:-arrowhead-v53-test-cloud-go}-network

volumes:
  blacklist-java-db:
  rust-timemanager-state:
  rust-sysmonitor-state:
  rust-datamanager-state:
  go-authentication-state:
  go-consumerauthorization-state:
  go-serviceorchestration-dynamic-state:
  go-serviceorchestration-simple-state:
  go-blacklist-state:
  go-translation-manager-state:
  go-test-translation-state:
  go-device-qos-evaluator-state:
  go-onboarding-state:
  go-datamanager-state:
  go-timemanager-state:
  go-eventhandler-state:
  go-plantdescriptionengine-state:
  go-configuration-state:
  go-choreographer-state:
  go-sysmonitor-state:
  go-gatekeeper-state:
  go-gatetunnel-state:
  go-aigym-state:
  go-certificate-authority-state:
  serviceregistry-data:
  serviceorchestration-dynamic-db:
  serviceorchestration-simple-db:
  consumerauthorization-db:
  authentication-db:
  blacklist-db:
  translation-manager-db:
  device-qos-evaluator-db:
  onboarding-db:
  datamanager-db:
  timemanager-db:
  eventhandler-db:
  plantdescriptionengine-db:
  configuration-db:
  choreographer-db:
  gatekeeper-data:
  gatetunnel-data:
  sysmonitor-data:
  certificate-authority-data:
  mqtt-data:
  amqp-data:

# Secrets reach the containers only as files under /run/secrets (security finding J7). Each is one file in secrets/
# (directory 700, files 600), written from .env by scripts/rotate-secrets.sh (generate, rotate or files).
secrets:
  # Java Blacklist (blacklist-java, 2026-10-24)
  AH_DB_ROOT_BLACKLIST: { file: ./secrets/AH_DB_ROOT_BLACKLIST }
  AH_DB_PW_BLACKLIST: { file: ./secrets/AH_DB_PW_BLACKLIST }
  AH_STORE_PW_BL: { file: ./secrets/AH_STORE_PW_BL }
  AH_PW_BL: { file: ./secrets/AH_PW_BL }
  AH_AUTHENTICATION_SECRET_KEY: { file: ./secrets/AH_AUTHENTICATION_SECRET_KEY }
  AH_PW_LCM: { file: ./secrets/AH_PW_LCM }
  AH_PW_RDP: { file: ./secrets/AH_PW_RDP }
  AH_PW_SR: { file: ./secrets/AH_PW_SR }
  CONSOLE_PASSWORD_HASH: { file: ./secrets/CONSOLE_PASSWORD_HASH }
  CONSOLE_PROXY_SECRET: { file: ./secrets/CONSOLE_PROXY_SECRET }
