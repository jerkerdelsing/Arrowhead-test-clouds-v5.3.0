{
  "name": "Authentication",
  "listen": ":8444",
  "cloudSuffix": "GoCloud.Company.arrowhead.eu",
  "certificate": "/certs/authentication.crt",
  "privateKey": "/certs/authentication.key",
  "ca": "/certs/ca.crt",
  "state": "/state/authentication.json",
  "passwordFile": "/certs/password",
  "bootstrapName": "Sysop",
  "bootstrapPasswordFile": "/certs/bootstrap-password",
  "crlFile": "/crl/ca.crl",
  "monitorEnabled": true,
  "amqpURL": "amqps://amqp-broker:5671",
  "mqttURL": "ssl://mqtt-broker:8883",
  "authenticationURL": "https://authentication:8444",
  "serviceRegistryURL": "https://serviceregistry:8443",
  "authorizationURL": "https://consumerauthorization:8445",
  "managementWhitelist": [
    "Onboarding"
  ],
  "managementPolicy": "authorization",
  "register": true,
  "advertiseAddress": "authentication",
  "advertisePort": 8444
}
